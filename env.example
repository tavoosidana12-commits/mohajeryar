# Liara Variables (set these in Liara dashboard > Variables)
# Example format:
# postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:secret@liara-postgres-host:5432/mohajeryar_db

# Optional Liara AI configuration:
LIARA_AI_API_KEY=
LIARA_AI_ENDPOINT=https://api.liara.ir/v1/chat/completions
LIARA_AI_MODEL=openai/gpt-4o-mini

# Optional (if you later add auth/payment):
# NEXT_PUBLIC_APP_URL=https://your-app.liara.run
